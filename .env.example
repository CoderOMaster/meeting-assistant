# ── API Keys ──────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
DEEPGRAM_API_KEY=...
CARTESIA_API_KEY=sk_car_...

# Cartesia: your cloned voice ID from https://play.cartesia.ai/voices
CARTESIA_VOICE_ID=xxx
CARTESIA_MODEL_ID=sonic-2

# Full Google Meet URL (https://meet.google.com/xxx-xxxx-xxx)
MEETING_URL=https://meet.google.com/xxx-xxxx-xxx
BOT_NAME=AI Assistant

# Device that captures meeting participants' audio (loopback from meeting output)
INPUT_DEVICE=BlackHole 2ch
# Device the meeting uses as its microphone (where bot speaks into)
OUTPUT_DEVICE=BlackHole 16ch

# ── Response Behaviour ─────────────────────────────────────────────────────────
# always    → respond to every utterance
# question  → only respond when transcript ends with "?"
# wake_word → only respond when transcript contains the wake word
RESPONSE_MODE=question
WAKE_WORD=hey keshav

SILENCE_MS=1200

#Add your prompt here and how do you want to structure it based on requirement
SYSTEM_PROMPT=You are Keshav, helpful AI assistant participating in a meeting. You listen carefully and give concise, accurate answers. Keep responses to 1-3 sentences unless more detail is clearly needed.
